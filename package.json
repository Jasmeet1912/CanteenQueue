{
  "name": "canteen-queue",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "netlify:build": "npm run db:push && npm run db:seed:if-empty && npm run build",
    "start": "next start",
    "render:start": "npm run db:push && npm run db:seed:if-empty && npm run start",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.js",
    "db:seed:if-empty": "tsx src/db/seed.js --if-empty",
    "setup": "npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.17",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15"
  }
}
